# Byte-compiled / optimized / DLL files
__pycache__/
*.py[cod]
*$py.class

# Poetry virtualenvs
.env
.venv
# poetry.lock is committed: it makes CI reproducible and gives the dependency
# cache a key that actually varies. It does not constrain anyone installing
# gen-surv from PyPI, which resolves against the metadata instead.

# Installer logs
pip-log.txt
pip-delete-this-directory.txt

# Unit test / coverage reports
htmlcov/
.tox/
.nox/
.coverage
.cache
nosetests.xml
coverage.xml
*.cover
*.py,cover

# Pytest
.pytest_cache/

# Jupyter Notebook checkpoints
.ipynb_checkpoints

# PyCharm
.idea/

# VSCode
.vscode/

# MacOS
.DS_Store

# System files
Thumbs.db
ehthumbs.db

# Build artifacts
build/
dist/
*.egg-info/

# Temporary
*.log
*.tmp
.hypothesis/

# MkDocs build output
site/

# Type checker cache
.mypy_cache/

# Literature PDFs used for the local research studies. Third-party
# copyrighted papers: never committed, force-added, archived into a release, or
# copied into a tracked directory. tests/test_papers_not_tracked.py enforces
# this.
papers/

# Research artifacts: generated from committed config, seeds and lock files,
# and never to be confused with source.
# scripts/run_pilot.py refuses to read a file containing production rows for
# the same reason.
research/*/results/raw/pilot.parquet
research/*/results/raw/production.parquet
research/*/results/raw/production.parquet.compact.parquet
research/*/results/raw/*.parts/
research/*/results/grid_convergence.parquet
research/*/results/ipcw_availability.parquet
research/*/results/processed/
research/*/results/figures/
research/*/protocol/experiment_lock.json

# LaTeX build byproducts from research manuscripts.
research/*/paper/*.aux
research/*/paper/*.bbl
research/*/paper/*.blg
research/*/paper/*.fdb_latexmk
research/*/paper/*.fls
research/*/paper/*.out
research/*/paper/*.pdf
research/*/paper/*.synctex.gz
