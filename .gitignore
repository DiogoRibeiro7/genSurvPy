# Byte-compiled / optimized / DLL files
__pycache__/
*.py[cod]
*$py.class

# Poetry virtualenvs
.env
.venv
# poetry.lock is committed: it makes CI reproducible and gives the dependency
# cache a key that actually varies. It does not constrain anyone installing
# gen-surv from PyPI, which resolves against the metadata instead.

# Installer logs
pip-log.txt
pip-delete-this-directory.txt

# Unit test / coverage reports
htmlcov/
.tox/
.nox/
.coverage
.cache
nosetests.xml
coverage.xml
*.cover
*.py,cover

# Pytest
.pytest_cache/

# Jupyter Notebook checkpoints
.ipynb_checkpoints

# PyCharm
.idea/

# VSCode
.vscode/

# MacOS
.DS_Store

# System files
Thumbs.db
ehthumbs.db

# Build artifacts
build/
dist/
*.egg-info/

# Temporary
*.log
*.tmp
.hypothesis/

# MkDocs build output
site/

# Type checker cache
.mypy_cache/

# Literature PDFs used for the research studies under research/.
# Local only: these are third-party copyrighted papers and must never be
# committed, force-added, archived into a release, or copied into a tracked
# directory. research/*/literature/ holds our own notes and bibliography
# instead. tests/test_papers_not_tracked.py enforces this.
papers/

# Pilot artefacts from the research studies. They are exploratory, they are
# regenerable from the config and seeds, and they must never be confused with
# frozen production results -- scripts/run_pilot.py refuses to read a file
# containing production rows for the same reason. Production results are
# tracked; these are not.
research/*/results/raw/pilot.parquet
research/*/results/processed/pilot_*
